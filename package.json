{
  "name": "rado",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0 <27.0.0"
  },
  "workspaces": [
    "app",
    "circuits",
    "contracts",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @rado/app",
    "build": "npm run build --workspace @rado/app",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:lan": "npm run dev:lan --workspace @rado/app"
  },
  "devDependencies": {
    "@noble/hashes": "^2.4.0",
    "circomlibjs": "^0.1.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3"
  }
}
